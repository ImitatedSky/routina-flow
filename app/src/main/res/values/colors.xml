<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 圖示底色＝標記卡片的奶油色 -->
    <color name="ic_launcher_background">#FDF8F4</color>

    <!-- 桌面小工具（亮色）：自畫底＋自訂文字色，確保在啟動器上對比清楚。暗色見 values-night -->
    <color name="widget_bg">#FFFAFAFA</color>
    <color name="widget_text_primary">#FF1C1B1F</color>
    <color name="widget_text_secondary">#FF5F6368</color>
    <color name="widget_accent">#FF1565C0</color>

    <!--
      色塊磚上的文字：磚底是程序自己的顏色（自帶背景，不受啟動器亮暗影響），
      因此固定白字即可，values-night 刻意不覆寫。
    -->
    <color name="widget_tile_text">#FFFFFFFF</color>
</resources>
